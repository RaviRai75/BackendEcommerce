# Sanchandana API — environment template
#
# Copy to `.env` and fill in environment-specific values. Never commit `.env`
# (security §30). Generate application-owned JWT, mock-payment, and notification
# secrets with `openssl rand -hex 32`; use provider-issued database, Cloudinary,
# and SMTP credentials.
# Every variable listed here is validated at boot by src/config/env.js; the
# process refuses to start if a required one is missing or malformed.

# --- Runtime -----------------------------------------------------------------
# Production must set NODE_ENV=production.
NODE_ENV=development
PORT=5000
API_PREFIX=/api

# --- Database (MongoDB Atlas) ------------------------------------------------
# Use a least-privilege database user, not the Atlas admin account (security §6).
MONGODB_URI=
MONGODB_DB_NAME=sanchandana

# --- Authentication ----------------------------------------------------------
# Access and refresh secrets MUST be different values, at least 32 characters.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL_MINUTES=15
ADMIN_ACCESS_TOKEN_TTL_MINUTES=10
REFRESH_TOKEN_TTL_DAYS=7
PASSWORD_RESET_TTL_MINUTES=30
# --- Client / CORS -----------------------------------------------------------
# Comma-separated exact origins. Never `*`. Production origins must be HTTPS.
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Public storefront origin used by canonical links and social previews.
# Production must use HTTPS and must match the frontend's VITE_SITE_URL.
# Provide only the origin: no path, query string, fragment, or credentials.
STOREFRONT_URL=http://localhost:5173

# --- Shipping serviceability -------------------------------------------------
# Comma-separated state allow-list. Comparisons are case-insensitive.
# Keep at least one state configured; add more states as service expands.
SHIPPING_ALLOWED_STATES=Karnataka

# --- Payments ----------------------------------------------------------------
# Set both values to enable MockPrepaid in development/test only. Production
# refuses MOCK_PREPAID; leave DISABLED until a real adapter is implemented.
PREPAID_PROVIDER=DISABLED
# MOCK_PREPAID_SECRET=
PAYMENT_ATTEMPT_TTL_MINUTES=30
PAYMENT_WEBHOOK_TOLERANCE_SECONDS=300

# --- Logging -----------------------------------------------------------------
LOG_LEVEL=info
# Human-readable logs for local development. Leave false in production.
LOG_PRETTY=true

# --- Rate limiting -----------------------------------------------------------
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=600

# --- Media -------------------------------------------------------------------
# Cloud name is public; API key and secret are server-only. Never use the secret
# in a VITE_ variable or return it from an API response. `demo` is local-only;
# production must use the provider-issued cloud name and credentials.
CLOUDINARY_CLOUD_NAME=demo
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# Create signed presets in Cloudinary with max_file_size matching the limits
# below and the documented format allow-lists. The API verifies them before use.
CLOUDINARY_IMAGE_UPLOAD_PRESET=sanchandana-product-images
CLOUDINARY_VIDEO_UPLOAD_PRESET=sanchandana-product-videos

# --- Request limits ----------------------------------------------------------
JSON_BODY_LIMIT_KB=64
UPLOAD_MAX_SIZE_MB=5
UPLOAD_VIDEO_MAX_SIZE_MB=50

# --- Email and notification dispatch ----------------------------------------
# Production requires smtp. console/none are development-only and never expose
# message bodies or recipient addresses in logs.
EMAIL_PROVIDER=console
# Production must replace this with a provider-verified sender identity/domain.
EMAIL_FROM=Sanchandana <no-reply@sanchandana.local>
# SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
# SMTP_USER=
# Use the SMTP account's app password, never a personal password.
# SMTP_APP_PASSWORD=
# Production: 64 hex characters (32 bytes), e.g. `openssl rand -hex 32`.
# Outside production, omission derives a deterministic key from JWT_ACCESS_SECRET.
NOTIFICATION_ENCRYPTION_KEY=
NOTIFICATION_ENCRYPTION_KEY_ID=notification-key-v1
# Rotation is a two-phase fleet rollout because an unknown key ID is terminal:
# 1. While the old key is active, pre-stage the future ID/key in a previous-key
#    slot on every producer and worker; wait for fleet convergence, or stop and
#    drain old workers before any producer activates the future key.
# 2. Activate the future key everywhere and retain the old ID/key in a slot.
# Remove an old slot only after all instances have converged and no PENDING or
# CLAIMED delivery references that ID. Do not rotate while all four slots are
# still needed. Configure both fields in each used slot; never log these values.
NOTIFICATION_PREVIOUS_ENCRYPTION_KEY_ID_1=
NOTIFICATION_PREVIOUS_ENCRYPTION_KEY_1=
NOTIFICATION_PREVIOUS_ENCRYPTION_KEY_ID_2=
NOTIFICATION_PREVIOUS_ENCRYPTION_KEY_2=
NOTIFICATION_PREVIOUS_ENCRYPTION_KEY_ID_3=
NOTIFICATION_PREVIOUS_ENCRYPTION_KEY_3=
NOTIFICATION_PREVIOUS_ENCRYPTION_KEY_ID_4=
NOTIFICATION_PREVIOUS_ENCRYPTION_KEY_4=
# One externally scheduled invocation claims at most this many deliveries.
NOTIFICATION_DISPATCH_BATCH_SIZE=100
NOTIFICATION_LEASE_SECONDS=120
