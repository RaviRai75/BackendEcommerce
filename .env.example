# Sanchandana API — environment template
#
# Copy to `.env` and fill in real values. Never commit `.env` (security §30).
# Generate each secret with:  openssl rand -hex 32
# Every variable listed here is validated at boot by src/config/env.js; the
# process refuses to start if a required one is missing or malformed.

# --- Runtime -----------------------------------------------------------------
NODE_ENV=development
PORT=5000
API_PREFIX=/api

# --- Database (MongoDB Atlas) ------------------------------------------------
# Use a least-privilege database user, not the Atlas admin account (security §6).
MONGODB_URI=
MONGODB_DB_NAME=sanchandana

# --- Authentication ----------------------------------------------------------
# Access and refresh secrets MUST be different values, at least 32 characters.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL_MINUTES=15
ADMIN_ACCESS_TOKEN_TTL_MINUTES=10
REFRESH_TOKEN_TTL_DAYS=7
PASSWORD_RESET_TTL_MINUTES=30
# --- Client / CORS -----------------------------------------------------------
# Comma-separated exact origins. Never `*`. Production origins must be HTTPS.
CORS_ALLOWED_ORIGINS=http://localhost:5173
STOREFRONT_URL=http://localhost:5173

# --- Payments ----------------------------------------------------------------
# MockPrepaid exercises initiation, verification, signed webhooks and refunds in
# development/test only. Production refuses MOCK_PREPAID; leave DISABLED until
# the documented PhonePe adapter contract is approved and implemented.
PREPAID_PROVIDER=MOCK_PREPAID
MOCK_PREPAID_SECRET=
PAYMENT_ATTEMPT_TTL_MINUTES=30
PAYMENT_WEBHOOK_TOLERANCE_SECONDS=300

# --- Logging -----------------------------------------------------------------
LOG_LEVEL=info
# Human-readable logs for local development. Leave false in production.
LOG_PRETTY=true

# --- Rate limiting -----------------------------------------------------------
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=600

# --- Shipping ----------------------------------------------------------------
# Comma-separated state names that are serviceable when a pincode is present in
# the geography reference collection. Missing pincodes remain unknown.
SHIPPING_ALLOWED_STATES=Karnataka

# --- Media -------------------------------------------------------------------
# Cloud name is public; API key and secret are server-only. Never use the secret
# in a VITE_ variable or return it from an API response.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Create signed presets in Cloudinary with max_file_size matching the limits
# below and the documented format allow-lists. The API verifies them before use.
CLOUDINARY_IMAGE_UPLOAD_PRESET=sanchandana-product-images
CLOUDINARY_VIDEO_UPLOAD_PRESET=sanchandana-product-videos

# --- Request limits ----------------------------------------------------------
JSON_BODY_LIMIT_KB=64
UPLOAD_MAX_SIZE_MB=5
UPLOAD_VIDEO_MAX_SIZE_MB=50

# --- Email -------------------------------------------------------------------
# console — writes the message to the server log. Development only, and refused
#           at boot in production: a password reset body contains a working
#           reset link, and security §26 forbids secrets in logs.
# none    — accepts and discards, so a deployment without email credentials
#           still functions.
# A real transactional provider is added in Task 28.
EMAIL_PROVIDER=console
EMAIL_FROM=Sanchandana <no-reply@sanchandana.local>
