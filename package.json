{
  "name": "sanchandana-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Sanchandana — modular monolith API for a Karnataka ethnic fashion e-commerce platform",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed": "node scripts/seed.js",
    "db:indexes": "node scripts/syncIndexes.js",
    "invoice:publish": "node scripts/publishInvoicePolicy.js",
    "notifications:dispatch": "node scripts/processNotifications.js",
    "media:preflight": "node scripts/verifyMediaMigration.js",
    "media:reconcile": "node scripts/reconcileMedia.js",
    "create:admin": "node scripts/createAdmin.js",
    "audit": "npm audit --omit=dev"
  },
  "dependencies": {
    "@node-rs/argon2": "2.0.2",
    "cloudinary": "2.10.1",
    "compression": "1.8.1",
    "cookie-parser": "1.4.7",
    "cors": "2.8.5",
    "csv-parse": "5.6.0",
    "dotenv": "16.4.7",
    "express": "4.22.2",
    "express-rate-limit": "^8.6.2",
    "helmet": "8.0.0",
    "jsonwebtoken": "9.0.2",
    "mongoose": "8.24.4",
    "nodemailer": "9.0.5",
    "pdfkit": "0.20.1",
    "pino": "9.6.0",
    "pino-http": "10.4.0",
    "zod": "3.24.1"
  },
  "devDependencies": {
    "mongodb-memory-server": "^10.1.4",
    "pino-pretty": "13.0.0",
    "supertest": "^7.1.3",
    "vite": "6.4.3",
    "vitest": "3.2.6"
  }
}
